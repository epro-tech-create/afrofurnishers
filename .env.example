# Copy to .env.local and fill in real values. Never commit .env.local.
ADMIN_PASSWORD=choose-a-strong-password-min-8-chars
ADMIN_SECRET=any-long-random-string-for-signing-sessions
# Set to 1 only when a reverse proxy in front of this app sets the visitor address.
# Leave it unset when people open the shop directly. A fake forwarded address cannot skip the sign-in lockout.
TRUST_PROXY=
# Neon Postgres. Use the pooled URL for the app. The direct URL is for schema changes.
# Pull both with: npx neon env pull
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon Auth. Pull with: npx neon env pull -s auth
# Generate NEON_AUTH_COOKIE_SECRET locally (at least 32 characters) and set the same value in Vercel.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Admin is the same server: http://localhost:4173/admin
# Sign in with ADMIN_PASSWORD. The page stays behind that login.
